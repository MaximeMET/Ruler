<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background layer.

  Flat duotone instead of a gradient on purpose: vector gradients need API 24 and the
  launcher icon is inflated by the launcher process itself, so every API level the app
  supports has to render this drawable. Two soft circles give the same "soft gradient"
  feel while staying plain paths.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base indigo. -->
    <path
        android:fillColor="#4F46E5"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Lighter indigo glow, top-left. -->
    <path
        android:fillColor="#6366F1"
        android:pathData="M-28,6a40,40 0 1,0 80,0a40,40 0 1,0 -80,0z" />

    <!-- Violet glow, bottom-right. -->
    <path
        android:fillColor="#7C3AED"
        android:pathData="M28,92a62,62 0 1,0 124,0a62,62 0 1,0 -124,0z" />
</vector>
