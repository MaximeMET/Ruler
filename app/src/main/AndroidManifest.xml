<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The app has no ads and no tracking and never touches the network on its own. The two
      permissions below are only used by the update check the user starts in settings:
      INTERNET fetches the latest release, REQUEST_INSTALL_PACKAGES hands the downloaded
      APK to the system installer. No storage permission is needed, the file lives in the
      app cache and travels to the installer through the provider below.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.OpenRuler">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.OpenRuler.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ProtractorActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.OpenRuler.Fullscreen" />

        <activity
            android:name=".CalibrationActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.OpenRuler" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.OpenRuler" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.OpenRuler" />

        <activity
            android:name=".UpdateActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.OpenRuler" />

        <provider
            android:name=".core.ApkProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
