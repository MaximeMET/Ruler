    <!-- About -->
    <string name="about_version">संस्करण %1$s</string>
    <string name="about_tagline">Android के लिए ओपन सोर्स रूलर और चांदा। कोई विज्ञापन नहीं, कोई ट्रैकिंग नहीं। ऐप केवल अपडेट जाँचने पर ही इंटरनेट से जुड़ता है।</string>
    <string name="about_license_title">लाइसेंस</string>
    <string name="about_license_body">MIT लाइसेंस के अंतर्गत जारी। आप इसे स्वतंत्र रूप से उपयोग, अध्ययन, संशोधन और वितरित कर सकते हैं।</string>
    <string name="about_disclaimer_title">अस्वीकरण</string>
    <string name="about_disclaimer_body">ऐप जैसा है वैसा ही दिया गया है, किसी प्रकार की गारंटी नहीं। सटीकता टचस्क्रीन और सही कैलिब्रेशन पर निर्भर है, इसलिए मान अनुमानित हैं।</string>
    <string name="about_source">सोर्स कोड</string>

